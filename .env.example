# Copy this file to .env for local runtime use.
# Never commit the real .env file.

COMPOSE_PROJECT_NAME=supply-chain-control-tower

# SQL Server / WideWorldImporters source
MSSQL_IMAGE=mcr.microsoft.com/mssql/server:2022-latest
MSSQL_PID=Developer
MSSQL_SA_PASSWORD=CHANGE_ME_WITH_A_STRONG_LOCAL_PASSWORD
MSSQL_HOST_PORT=14333
MSSQL_MEMORY_LIMIT_MB=3584
WWI_DATABASE=WideWorldImporters

# Canonical frozen source baseline
WWI_BACKUP_FILENAME=WideWorldImporters-Full.bak
WWI_BACKUP_URL=https://github.com/microsoft/sql-server-samples/releases/download/wide-world-importers-v1.0/WideWorldImporters-Full.bak
WWI_BACKUP_SIZE_BYTES=127111168
WWI_BACKUP_SHA256=E842BAD6CE02F74F166947E559DAB1B476EDD7EAAE3DA2AB9E3F522F1DD87124

# Frozen 2026 portfolio baseline.
# The file is not committed to Git; bootstrap downloads it from the GitHub Release when absent.
WWI_BASELINE_FILENAME=full-master/wwi-full-master-2026-09-15.bak
WWI_BASELINE_URL=https://github.com/conradmanao24/supply-chain-control-tower-data-platform/releases/download/v1.0-data-baseline/wwi-full-master-2026-09-15.bak
WWI_BASELINE_SIZE_BYTES=1662111744
WWI_BASELINE_SHA256=1F779A53D9AE1E5B90F2C62BA74D3E48E5FED0F75096E5EC798A09ABF04DEE30

# PostgreSQL warehouse
POSTGRES_VERSION=17.11
DWH_DB=supply_chain_dw
DWH_USER=supply_chain_dw
DWH_PASSWORD=CHANGE_ME_WITH_A_STRONG_LOCAL_PASSWORD
DWH_HOST_PORT=15434

# Airflow 3 runtime
AIRFLOW_VERSION=3.3.1
AIRFLOW_PYTHON_VERSION=3.12
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=CHANGE_ME_WITH_A_STRONG_LOCAL_PASSWORD
AIRFLOW_FERNET_KEY=GENERATE_A_VALID_FERNET_KEY
AIRFLOW_API_SECRET_KEY=CHANGE_ME_WITH_A_RANDOM_SECRET
AIRFLOW_JWT_SECRET=CHANGE_ME_WITH_A_RANDOM_SECRET
AIRFLOW_ADMIN_USERNAME=admin
# Airflow UI password is generated locally by SimpleAuthManager at first startup.
# Retrieve it with the command documented in README.md; never commit it.
AIRFLOW_API_PORT=28080

# Realtime serving API
REALTIME_API_PORT=18000
WWI_SOURCE_USER=sct_airflow_reader
WWI_EVENT_USER=sct_event_consumer
WWI_EVENT_PASSWORD=CHANGE_ME_WITH_A_STRONG_LOCAL_PASSWORD
WWI_SOURCE_PASSWORD=CHANGE_ME_WITH_A_STRONG_LOCAL_PASSWORD

